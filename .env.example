# ── SignalProof server configuration ─────────────────────────────
# The server auto-loads this file (project root) at startup — no dotenv package
# needed. Explicit process env vars always win over .env values.
# Everything is optional: with no credentials the app runs fully on its
# checked-in, dated fixtures and labels every data mode honestly.

PORT=8787
HOST=0.0.0.0

# ── Market data ──────────────────────────────────────────────────
# "live"  → Yahoo chart API (query2 first, then query1 — query1 is often
#           rate-limited with 429), then the TTL response cache, then the
#           bundled dated snapshot. Every response is labelled LIVE or CACHED.
# "cached"→ never call the network; use the TTL cache then the bundled
#           snapshot (fully deterministic demo mode).
MARKET_MODE=live
MARKET_LIVE_TIMEOUT_MS=10000
# Response-cache TTL in ms. A cache hit is served instantly (labelled CACHED
# with its original fetch time + age) instead of re-hitting the provider.
MARKET_CACHE_TTL_MS=900000
# Override only for tests (forces a live failure to prove the fallback path).
# YAHOO_BASE_URL=https://query1.finance.yahoo.com

# ── News ─────────────────────────────────────────────────────────
# "cached" uses the checked-in dated headline set. No live news provider is
# wired this sprint (PRD cut); the missing-news degraded scenario exercises
# the unavailable path.
NEWS_MODE=cached

# ── LLM (OpenAI-compatible: OpenAI, OpenRouter, Groq, Together…) ──
# on/off/true/false/openai. When on, the Filing + News agents ask the model to
# phrase evidence from the SAME bounded inputs; outputs are validated against
# the citation contract and anything invalid is replaced by the deterministic
# rules path (badge on each agent card shows LLM vs rules). Responses are
# cached in-memory by prompt hash → profile re-runs are identical and free.
LLM_MODE=on
OPENAI_API_KEY=
# Base URL may be the bare API root or include /chat/completions — both work.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=minimax/minimax-m3:free
LLM_TIMEOUT_MS=8000

# ── Embeddings (RAG) ─────────────────────────────────────────────
# "local" = deterministic hashed n-gram vectors + cosine (no key needed).
# "openai" adds real embeddings when a key exists; falls back to local on error.
EMBEDDINGS_MODE=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Persistence (server-side only; never exposed to the browser) ──
# Create the table with: npx supabase db push  (migration in supabase/migrations/)
# Unset/failed → labelled device-local fallback (server/data/local-sessions.json).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SESSIONS_TABLE=analysis_sessions
